# AI DevOps Agent 配置示例
# 复制本文件为 .env 并填入真实值

# LLM API Key（三选一，按优先级读取：ANTHROPIC_API_KEY > API_KEY > DEEPSEEK_API_KEY）
ANTHROPIC_API_KEY=your-api-key-here

# 模型配置
MODEL_ID=claude-3-5-sonnet-20240620
# 过载降级模型（可选，留空则不降级）
FALLBACK_MODEL_ID=

# API Base URL（可选，用于兼容第三方代理；留空则使用 Anthropic 官方地址）
# 例如 DeepSeek: https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
